{
  "name": "oficina-saas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "npm run db:migrate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:deployment": "node scripts/smoke-deployment.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx db/migrate.ts",
    "db:migrate-photos:r2": "tsx scripts/migrate-service-photos-to-r2.ts",
    "db:import-shoficina": "tsx scripts/import-shoficina.ts",
    "db:repair-shoficina-dates": "tsx scripts/repair-shoficina-order-dates.ts",
    "db:seed-owner": "tsx db/seed-owner.ts",
    "dev:cloudflare": "vite dev --port 3001",
    "build:cloudflare": "vite build && next typegen",
    "preview:cloudflare": "npm run build:cloudflare && vite preview",
    "deploy:cloudflare": "npm run build:cloudflare && vinext-cloudflare deploy --skip-build"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "aws4fetch": "^1.0.20",
    "better-auth": "^1.7.5",
    "bufferutil": "^4.1.0",
    "drizzle-orm": "^0.45.2",
    "next": "16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.21.3",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-beta.v.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "@vinext/cloudflare": "^1.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-rsc": "^0.5.38",
    "cf": "1.0.0-beta.15",
    "drizzle-kit": "^0.31.4",
    "prettier": "^3.6.2",
    "react-server-dom-webpack": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vinext": "^1.3.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "optionalDependencies": {
    "@rolldown/binding-win32-x64-msvc": "^1.2.9",
    "lightningcss-win32-x64-msvc": "^1.33.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.0"
    }
  },
  "type": "module"
}
