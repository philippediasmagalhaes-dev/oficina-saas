# Public application URL after the Vercel project and domain are defined.
NEXT_PUBLIC_APP_URL=https://app.example.com

# Production database (recommended: Vercel Postgres or Neon).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Authentication and role-based access.
AUTH_SECRET=replace-with-a-generated-secret
AUTH_URL=https://app.example.com

# Transactional email and WhatsApp/SMS notifications.
RESEND_API_KEY=re_xxxxxxxxx
WHATSAPP_ACCESS_TOKEN=replace-me
WHATSAPP_PHONE_NUMBER_ID=replace-me

# Subscription billing.
STRIPE_SECRET_KEY=sk_live_xxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxxxxxxxx

# Work-order photos and documents.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxx

# Error monitoring.
NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
