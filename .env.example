# Neon Postgres (use the pooled connection string).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Owner-only authentication served by this app and stored in Neon.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters

# First invited owner, used only by `npm run db:seed-owner`.
OWNER_EMAIL=
OWNER_PASSWORD=
OWNER_NAME=Proprietário

# Public application URL after the deployment domain is defined.
NEXT_PUBLIC_APP_URL=https://oficina-saas.contato-ad4.workers.dev

# Private Cloudflare R2 bucket used by both Workers and the Vercel rollback.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=oficina-saas-photos

# Comma-separated origins allowed to call Better Auth (no paths).
AUTH_TRUSTED_ORIGINS=http://localhost:3000

# Optional assisted vehicle lookup. Use {plate} where the normalized plate must be inserted.
PLATE_LOOKUP_PROVIDER=fipeplaca
PLATE_LOOKUP_API_URL=
PLATE_LOOKUP_API_TOKEN=

# Optional Meta WhatsApp Cloud API automation. Manual wa.me links work without these values.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WORKSHOP_ID=
WHATSAPP_REMINDER_TEMPLATE_NAME=
WHATSAPP_READY_TEMPLATE_NAME=
WHATSAPP_GRAPH_API_VERSION=v23.0
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
CRON_SECRET=
