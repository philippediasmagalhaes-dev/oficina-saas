# Neon Postgres (use the pooled connection string).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Owner-only authentication served by this app and stored in Neon.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters

# First invited owner, used only by `npm run db:seed-owner`.
OWNER_EMAIL=
OWNER_PASSWORD=
OWNER_NAME=Proprietário

# Public application URL after the Vercel project and domain are defined.
NEXT_PUBLIC_APP_URL=https://oficina-saas-green.vercel.app
